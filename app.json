{
  "expo": {
    "name": "Calico",
    "slug": "calico-shop",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.calico.shop"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.calico.shop",
      "versionCode": 4
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "calico",
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Calico uses your photos to add a customer picture.",
          "cameraPermission": "Calico uses the camera to take a customer picture.",
          "microphonePermission": false
        }
      ],
      [
        "react-native-share",
        {
          "android": ["com.whatsapp", "com.whatsapp.w4b"],
          "ios": ["whatsapp"]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "579e38af-346c-46c6-bd7e-7459cdba8823"
      }
    }
  }
}
